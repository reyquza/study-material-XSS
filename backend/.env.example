# Gemini を使う場合はここにAPIキーを貼って、このファイルを「.env」という名前でコピーする。
#   cp .env.example .env
# キーは Google AI Studio (https://aistudio.google.com/apikey) で無料で発行できる。
#
# ★キーが無くてもOK: 未設定ならモック応答で動くので、ハンズオンは成立します。
GEMINI_API_KEY=

# （任意）使うモデルを明示したいとき。カンマ区切りで上から順に試す。
# 未指定なら既定 (gemini-3.5-flash → gemini-3-flash-preview → gemini-flash-latest) を試し、
# 全滅したら「このキーで実際に使えるモデル」を自動検出して再試行します。
# 使えるモデル名は起動後に  curl http://localhost:8000/api/ai/health  で確認できます。
# GEMINI_MODELS=gemini-3.5-flash,gemini-3-flash-preview
